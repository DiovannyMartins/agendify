# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=          # sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=                      # sb_secret_... (server-only)

# Cloudflare Turnstile (anti-bot, §17) — both keys or neither.
# When both are set the widget renders and the gate is fail-closed.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=                 # 0x... (public)
TURNSTILE_SECRET_KEY=                           # 0x... (server-only)

# Base URL for email redirects (server-only; prefer APP_URL over NEXT_PUBLIC_APP_URL)
APP_URL=http://localhost:3000

# Production (Vercel)
# APP_URL=https://agendify-liart.vercel.app

# Booking reminders (INC-2, Pro) — Edge Function `booking-reminders`.
# Until RESEND_* are set, reminders are a safe no-op (nothing sent, nothing marked).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Shared secret between the pg_cron/pg_net dispatch and the Edge Function.
REMINDER_CRON_SECRET=

# Customer self-service cancellation (INC-3). Server-only secret used to derive
# the cancellation token from a booking's public code (HMAC-SHA256). Unset = the
# end-user cancel action is disabled (fail-closed; no token is shown).
CANCEL_TOKEN_SECRET=
